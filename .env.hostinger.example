HOSTINGER_HOST=seu-host-ou-ip
HOSTINGER_USER=seu-usuario
HOSTINGER_PORT=65002
HOSTINGER_REMOTE_DIR=/home/seu-usuario/apps/skyscanner

# Opcional: caminho para chave SSH local
HOSTINGER_SSH_KEY=

# Opcional: senha SSH/SFTP se nao usar chave
HOSTINGER_PASS=

# Opcional: 1 para rodar npm install no servidor
HOSTINGER_RUN_NPM_INSTALL=1

# Opcional: 1 para instalar chromium do playwright no servidor
HOSTINGER_INSTALL_PLAYWRIGHT=1

# Opcional: caminhos absolutos no servidor
HOSTINGER_NPM_BIN=npm
HOSTINGER_NPX_BIN=npx
